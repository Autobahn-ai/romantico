# --- Required ---
OPENAI_API_KEY=sk-your-openai-key

# Company search (pick one provider)
APOLLO_API_KEY=your-apollo-api-key

# Contact lookup fallback (optional if Apollo returns emails)
HUNTER_API_KEY=your-hunter-api-key

# Google Sheets (service account JSON path)
GOOGLE_SHEETS_CREDENTIALS_FILE=./google-service-account.json
GOOGLE_SHEET_ID=your-spreadsheet-id-from-url
GOOGLE_SHEET_TAB=Leads

# --- Search filters ---
SEARCH_INDUSTRY=SaaS
SEARCH_LOCATION=United States
SEARCH_LIMIT=5

# --- Your product (used in email generation) ---
PRODUCT_NAME=Your Product
PRODUCT_DESCRIPTION=AI-powered sales automation that helps teams book more qualified meetings.

# --- OpenAI models ---
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
OPENAI_EMAIL_MODEL=gpt-4o-mini
